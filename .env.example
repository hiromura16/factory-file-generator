# 実際の認証情報は公開せず、配備先の .env で管理します。
BIND_IP=127.0.0.1
APP_PORT=3561
TZ=Asia/Tokyo
APP_MEMORY=512m
APP_CPUS=1.0
# ホスト側で実行中に確保する空きメモリ（GiB）。APP_MEMORYはコンテナの上限です。
MIN_AVAILABLE_GIB=1
LANDING_DIR=/absolute/factory-data/landing

# 任意: ビルド時の通信のみ。未使用時は6行ともコメントのままにする。
# 大文字・小文字は同じ値にする。認証情報を含むURLは公開しない。
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1
# http_proxy=
# https_proxy=
# no_proxy=localhost,127.0.0.1,::1
